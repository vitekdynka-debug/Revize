{
  "name": "revize",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "spike:dev": "pnpm --filter @revize/spike-qr dev",
    "spike:build": "pnpm --filter @revize/spike-qr build",
    "check:licenses": "node scripts/check-licenses.mjs",
    "api:dev": "pnpm --filter @revize/api dev",
    "db:test": "docker run --rm -d --name revize-test-db -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16-alpine",
    "db:test:stop": "docker stop revize-test-db",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
